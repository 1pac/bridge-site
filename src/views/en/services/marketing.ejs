                                <h3>Difficulty generating interest among physicians in new drugs</h3>
                            </li>
                            <li class="js-fadein">
                                <div>
                                    <img src="../../../<%= ASSET_PATH %>asset/img/services/issue2.svg" alt="ISSUE02">
