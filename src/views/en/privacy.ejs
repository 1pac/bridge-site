    , canonical: "/privacy.html" , ogUrl: "/privacy.html" , ogImage: "asset/img/ogp.png" ,
    ogsiteName: "TCROSS Co., Ltd." , basePath: "../../" , selected: "selected" , optionJp: "JP" , optionEn: "EN" ,
